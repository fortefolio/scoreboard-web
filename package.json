{
  "name": "scoreboard-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest",
    "test:run": "vitest run",
    "test:affected": "node scripts/test-affected.mjs",
    "test:report": "vitest run --reporter=html --outputFile=test-results/html/index.html",
    "test:report:preview": "npx vite preview --outDir test-results/html",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test tests/e2e/smoke-prod.spec.ts",
    "sync:i18n": "node scripts/sync-i18n.js",
    "check:i18n": "node scripts/sync-i18n.js --check",
    "replay:match136": "tsx scripts/interactive-match-136.ts",
    "replay:basketball": "tsx scripts/interactive-basketball-game.ts",
    "replay:padel": "tsx scripts/interactive-padel-game.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.100.0",
    "next": "^16.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.18.0",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/ui": "^4.1.12",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "fast-check": "^4.8.0",
    "happy-dom": "^21.0.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12",
    "wrangler": "^4.93.0"
  }
}
