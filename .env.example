# Copy to .env.local and fill in.

# For local development against `supabase start`, use:
#   NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=<value printed by `supabase status -o env`>
#
# For development against a remote Supabase project, copy the URL + anon key
# from Project Settings → API. Never commit production values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
